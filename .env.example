# =============================================================================
# dev-stack-watcher-mcp - configuration
# Copy this file to .env and fill in your keys:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Claude API (REQUIRED to generate a summary)
# Create a key at https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-WITH-YOUR-KEY

# Model used for summarisation.
CLAUDE_MODEL=claude-opus-5

# Fallback model used if Claude declines the request.
CLAUDE_FALLBACK_MODEL=claude-opus-4-8

# Enable the server-side fallback (true / false).
CLAUDE_ENABLE_FALLBACK=true

# Maximum response length, in tokens.
CLAUDE_MAX_TOKENS=16000

# Reasoning depth: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Retry count for network errors and rate limits.
CLAUDE_RETRIES=3

# -----------------------------------------------------------------------------
# GitHub (OPTIONAL but strongly recommended)
# A fine-grained or classic token WITH NO SCOPES: only public reads are made.
# Without a token: 60 requests/hour instead of 5000.
# https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# Repositories watched for new releases (comma separated).
GITHUB_WATCHED_REPOS=microsoft/TypeScript,nodejs/node,facebook/react,vercel/next.js,vitejs/vite,oven-sh/bun,denoland/deno,sveltejs/svelte,tailwindlabs/tailwindcss,anthropics/anthropic-sdk-typescript,modelcontextprotocol/servers

# Number of trending repositories to fetch.
GITHUB_TRENDING_LIMIT=15

# Releases inspected per watched repository.
GITHUB_RELEASES_PER_REPO=3

# Time window in days (trending repositories and releases).
GITHUB_LOOKBACK_DAYS=7

# Custom search query (leave empty for the automatic "created:>=<date>").
# Example: language:typescript stars:>50 created:>=2026-08-01
GITHUB_TRENDING_QUERY=

# -----------------------------------------------------------------------------
# Dev.to (OPTIONAL: public reads need no key)
# https://dev.to/settings/extensions
# -----------------------------------------------------------------------------
DEVTO_API_KEY=

# Number of popular articles to fetch.
DEVTO_ARTICLE_LIMIT=15

# Popularity window in days (1 = today's articles).
DEVTO_TOP_DAYS=1

# -----------------------------------------------------------------------------
# Storage and pipeline
# -----------------------------------------------------------------------------
# SQLite file path (created automatically, migrations included).
DB_PATH=./data/watch.db

# Maximum number of items sent to Claude (keeps cost and context in check).
MAX_ITEMS_PER_SUMMARY=80

# Maximum duration of an outgoing HTTP request, in milliseconds.
HTTP_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
MCP_NAME=dev-stack-watcher
MCP_VERSION=1.0.0

# --- Streamable HTTP transport (`npm run mcp:http`) ---
# The stdio mode (`npm run mcp`) uses none of these variables.

# Listening port for the MCP endpoint.
MCP_PORT=3000

# Listening interface. 127.0.0.1 = local only (default, safest).
# Use 0.0.0.0 to accept connections from the network or from Docker.
MCP_HOST=127.0.0.1

# Endpoint path: the final URL is http://<host>:<port><path>
MCP_PATH=/mcp

# Idle time (minutes) before an HTTP session is closed automatically.
# MCP clients do not always signal that they disconnected.
MCP_SESSION_TTL_MIN=30

# Token required in the "Authorization: Bearer <token>" header.
# Empty = no authentication (acceptable on 127.0.0.1 only).
# Generate one: node -e "console.log(require('crypto').randomUUID())"
MCP_TOKEN=

# -----------------------------------------------------------------------------
# Logging: debug | info | warn | error | silent
# (every log line goes to stderr, never to stdout)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
